{
  "name": "oc-lark-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Relay Lark events through OpenCode decisions into a session, built with Effect",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test",
    "verify": "bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@effect/vitest": "4.1.0",
    "@opencode/client": "2.3.0",
    "@opencode/plugin": "2.3.0",
    "@opencode/schema": "2.3.0",
    "@types/node": "25.0.3",
    "effect": "4.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.3.0",
    "@opencode/schema": "2.3.0",
    "effect": "4.1.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.4"
}
